{
    "version": "1.0.0",
    "title": "Docker-in-Docker Chaos Experiment",
    "description": "Test resilience of Docker-in-Docker setup under failure conditions",
    "tags": ["docker", "chaos", "resilience"],
    "steady-state-hypothesis": {
        "title": "Services are healthy",
        "probes": [
            {
                "type": "probe",
                "name": "check_portainer_health",
                "tolerance": true,
                "provider": {
                    "type": "http",
                    "url": "http://localhost:9003",
                    "method": "GET",
                    "timeout": 5
                }
            },
            {
                "type": "probe",
                "name": "check_docs_health",
                "tolerance": true,
                "provider": {
                    "type": "http",
                    "url": "http://localhost:8082",
                    "method": "GET",
                    "timeout": 5
                }
            },
            {
                "type": "probe",
                "name": "check_api_health",
                "tolerance": true,
                "provider": {
                    "type": "http",
                    "url": "http://localhost:5000/api/health",
                    "method": "GET",
                    "timeout": 5
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "stop_random_container",
            "provider": {
                "type": "python",
                "module": "chaosdocker.actions",
                "func": "stop_container",
                "arguments": {
                    "container_name": "docs-server"
                }
            },
            "pauses": {
                "after": 10
            }
        },
        {
            "type": "action",
            "name": "restart_dind",
            "provider": {
                "type": "python",
                "module": "chaosdocker.actions",
                "func": "restart_container",
                "arguments": {
                    "container_name": "dind"
                }
            },
            "pauses": {
                "after": 30
            }
        },
        {
            "type": "action",
            "name": "simulate_high_cpu",
            "provider": {
                "type": "process",
                "path": "stress-ng",
                "arguments": ["--cpu", "4", "--timeout", "30s"],
                "background": true
            },
            "pauses": {
                "after": 35
            }
        },
        {
            "type": "action",
            "name": "simulate_network_latency",
            "provider": {
                "type": "process",
                "path": "tc",
                "arguments": ["qdisc", "add", "dev", "eth0", "root", "netem", "delay", "100ms"],
                "background": false
            },
            "pauses": {
                "after": 20
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "remove_network_latency",
            "provider": {
                "type": "process",
                "path": "tc",
                "arguments": ["qdisc", "del", "dev", "eth0", "root"]
            }
        },
        {
            "type": "action",
            "name": "start_stopped_containers",
            "provider": {
                "type": "python",
                "module": "chaosdocker.actions",
                "func": "start_container",
                "arguments": {
                    "container_name": "docs-server"
                }
            }
        }
    ]
}