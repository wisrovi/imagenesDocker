FROM wisrovi/agy-edc:base

# The backup generated by 01_base/run_base.sh is copied into the build context
# (as agy-config-backup/.gemini) before the image is built. This makes the
# authentication data available inside the final image, so agy starts without
# prompting for login.
COPY agy-config-backup/.gemini /root/.gemini

# Ensure the files are owned by root (the container runs as root by default)
RUN chown -R root:root /root/.gemini

# Set entrypoint to the original one (if any). The base image already defines the entrypoint for agy.
