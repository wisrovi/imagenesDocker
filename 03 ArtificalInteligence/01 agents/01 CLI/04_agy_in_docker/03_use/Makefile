# Makefile for 03_use – Ejecuta la imagen final publicada en Docker Hub

.PHONY: all run clean

all: run
	@echo "✅  03_use – Todo completado"

# Ejecuta la imagen final (wisrovi/agy-edc:v1.1.0)
run:
	@echo "🚀  Lanzando imagen final…"
	cd $(CURDIR) && ./run.sh

clean:
	@echo "🧹  No hay artefactos locales que limpiar en 03_use"
