# ==========================================
# CONFIGURACIÓN - PyPI Traffic Generator
# Copiar este archivo a .env y ajustar valores
# ==========================================

# Paquete objetivo en PyPI
TARGET_PACKAGE=wpipe

# Límite de descargas antes del descanso largo
BATCH_LIMIT=50

# Tiempos de espera entre descargas (segundos)
SHORT_WAIT_MIN=60
SHORT_WAIT_MAX=300

# Tiempos de descanso después de BATCH_LIMIT (segundos)
LONG_WAIT_MIN=1800
LONG_WAIT_MAX=3600

# Versiones de Python (separadas por espacios)
PYTHON_VERSIONS=3.8-slim 3.9-slim 3.10-slim 3.11-slim 3.12-slim 3.13-slim

# Tipos de OS
OS_TYPES=linux/x86_64 linux/aarch64 linux/armv7 windows/amd64 windows/arm64 macos/x86_64 macos/arm64 freebsd/amd64

# Versiones de pip
PIP_VERSIONS=20.0 20.1 20.2 20.3 21.0 21.1 21.2 21.3 22.0 22.1 22.2 22.3 23.0 23.1 23.2 23.3 24.0 24.1 24.2 24.3

# Timeout para cada operación (segundos)
TIMEOUT_SEC=60

# ==========================================
# TELEGRAM (opcional)
# ==========================================
# TG_TOKEN=tu_token_aqui
# TG_CHAT_ID=tu_chat_id_aqui